<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31+) system splash screen:
         pink brand background with a white tinted logo, for all themes. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo_light</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>
</resources>
